# ── dependencies ────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── testing ─────────────────────────────────────────────────────
/coverage

# ── next.js ─────────────────────────────────────────────────────
/.next/
/out/

# ── production ──────────────────────────────────────────────────
/build

# ── misc ────────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── debug logs ──────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── env files — secrets NEVER enter git ─────────────────────────
# Only .env.example (placeholder values) is committed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── vercel ──────────────────────────────────────────────────────
.vercel

# ── typescript ──────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── caches ──────────────────────────────────────────────────────
.eslintcache
.turbo
*.log

