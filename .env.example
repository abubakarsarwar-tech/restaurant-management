# ---------------------------------------------------------------------------
# Environment Variables — copy to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored). Validated at boot by `config/env.ts`.
# ---------------------------------------------------------------------------

# --- Database (MySQL 8) -----------------------------------------------------
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:rootpassword@localhost:3306/restaurant_db"

# --- Auth (Part 2) ----------------------------------------------------------
# Generate: openssl rand -base64 64   (min 32 chars)
JWT_SECRET="change-me-super-long-random-secret-minimum-32-characters"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Maps (public: used in browser for address picker / store locator) ------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Cloudinary (image CDN for dishes) --------------------------------------
# public cloud name is safe for the browser (unsigned delivery URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# server-only secrets (uploads/deletes from API routes)
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- WhatsApp ordering (public: click-to-chat deep links) -------------------
# international format without "+", e.g. 15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Currency / locale for price formatting ---------------------------------
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_LOCALE="en-US"
